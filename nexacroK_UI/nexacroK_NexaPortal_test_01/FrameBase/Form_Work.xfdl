								+" NexacroPortal01_onerror e = "+e+"\n");
}


this.Button10_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	this.TextArea00.deleteText();
};

this.Button11_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	objPortal.get_form().CheckBox00.value=true;
	objPortal.get_form().CheckBox01.value=true;
	objPortal.get_form().CheckBox02.value=true;

};


this.Button11_00_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	objPortal.get_form().Button00.click();
};

this.Button11_00_00_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
