<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="Form_Work" width="1280" height="720" titletext="Form_Work">
    <Layouts>
      <Layout width="1280" height="720" screenid="Desktop_screen">
        <NexacroPortal id="NexacroPortal00" taborder="0" text="NexacroPortal00" left="15" top="30" width="619" height="523" appkey="nexacroK_mfe_sub2" apppath="http://172.10.12.45:9090/nexacroK/nexacroK_mfe_sub2" formurl="" automount="true" onmount="NexacroPortal00_onmount" onunmount="NexacroPortal00_onunmount" onerror="NexacroPortal00_onerror"/>
        <NexacroPortal id="NexacroPortal01" taborder="1" text="NexacroPortal01" left="640" top="30" width="619" height="523" appkey="nexacroK_mfe_sub1" apppath="http://172.10.12.45:9090/nexacroK/nexacroK_mfe_sub1" formurl="" automount="true" onmount="NexacroPortal01_onmount" onunmount="NexacroPortal01_onunmount" onerror="NexacroPortal01_onerror"/>
        <Button id="Button01" taborder="2" text="NexacroPortal&#13;&#10;properties" left="170" top="600" width="90" height="45" onclick="Button01_onclick"/>
        <TextArea id="TextArea00" taborder="3" left="882" top="594" width="396" height="123" wordWrap="char"/>
        <Button id="Button00" taborder="4" text="mount function" left="267" top="600" width="97" height="45" onclick="Button00_onclick"/>
        <Button id="Button00_00" taborder="5" text="unmount function" left="371" top="600" width="117" height="45" onclick="Button00_00_onclick"/>
        <Button id="Button02" taborder="6" text="appkey set" left="495" top="600" width="71" height="45" onclick="Button02_onclick"/>
        <Button id="Button03" taborder="7" text="apppath set" left="573" top="600" width="80" height="45" onclick="Button03_onclick"/>
        <Button id="Button04" taborder="8" text="formurl set" left="660" top="600" width="80" height="45" onclick="Button04_onclick"/>
        <Button id="Button05" taborder="9" text="automount true" left="171" top="655" width="99" height="45" onclick="Button05_onclick"/>
        <Button id="Button06" taborder="10" text="automount false" left="278" top="655" width="95" height="45" onclick="Button06_onclick"/>
        <Button id="Button07" taborder="11" text="properties rest" left="381" top="655" width="103" height="45" onclick="Button07_onclick"/>
        <Button id="Button08" taborder="12" text="mainframe" left="492" top="655" width="73" height="45" onclick="Button08_onclick"/>
        <Button id="Button09" taborder="13" text="form" left="573" top="655" width="49" height="45" onclick="Button09_onclick"/>
        <Button id="Button10" taborder="14" text="TextArea00.deleteText" left="630" top="655" width="144" height="45" onclick="Button10_onclick"/>
        <Radio id="Radio00" taborder="15" left="26" top="600" width="135" height="77" innerdataset="innerdataset" codecolumn="codecolumn" datacolumn="datacolumn">
          <Dataset id="innerdataset">
            <ColumnInfo>
              <Column id="codecolumn" size="256"/>
              <Column id="datacolumn" size="256"/>
            </ColumnInfo>
            <Rows>
              <Row>
                <Col id="codecolumn">0</Col>
                <Col id="datacolumn">NeacroPortal00</Col>
              </Row>
              <Row>
                <Col id="codecolumn">1</Col>
                <Col id="datacolumn">NeacroPortal01</Col>
              </Row>
            </Rows>
          </Dataset>
