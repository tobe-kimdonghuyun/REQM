<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="DataObjectSample" width="1280" height="670" onload="DataObjectSample_onload">
    <Layouts>
      <Layout height="670" width="1280">
        <Static id="stc_title" taborder="0" text="[비가시적] DataObject 동적 생성 샘플" left="10" top="10" width="700" height="28" font="bold 14 'Malgun Gothic'" color="#065f46"/>
        <Static id="stc_api_url" taborder="1" text="API: GET https://jsonplaceholder.typicode.com/posts" left="10" top="44" width="800" height="22" color="#1a56db"/>
        <Static id="stc_desc2" taborder="2" text="new nexacro.DataObject() + new nexacro.Dataset() + new nexacro.Grid() 를 모두 동적으로 생성하고 REST API를 호출합니다." left="10" top="66" width="1200" height="22" color="#555555"/>
        <Button id="btn_create" taborder="3" text="DataObject 동적 생성" left="10" top="96" width="170" height="32" onclick="btn_create_onclick"/>
        <Button id="btn_search" taborder="4" text="게시글 조회 (GET)" left="190" top="96" width="150" height="32" onclick="btn_search_onclick"/>
        <Button id="btn_users" taborder="5" text="사용자 조회 (GET)" left="350" top="96" width="150" height="32" onclick="btn_users_onclick"/>
        <Button id="btn_clear" taborder="6" text="전체 삭제" left="510" top="96" width="90" height="32" onclick="btn_clear_onclick"/>
        <Static id="stc_status" taborder="7" text="DataObject 미생성" left="614" top="102" width="600" height="22" color="#cc0000"/>
        <Static id="stc_result" taborder="8" text="" left="10" top="136" width="1240" height="22" color="#333333"/>
        <Div id="div_grid" left="10" top="164" width="1250" height="496"/>
      </Layout>
    </Layouts>
    <Script type="xscript5.1"><![CDATA[
// this.bCreated (Form 속성) 으로 관리 — var 클로저 변수 사용 금지
// Div 내 동적 생성 컴포넌트 접근: this.div_grid.form.all["grd_result"]
//
// [자동 바인딩 방식]
// DataObject ─binddataobject→ Dataset
//   각 컬럼에 datapath("@.키명") 설정 → loadFromDataObject() 한 번으로 자동 반영
//   addRow / setColumn 수동 루프 완전 제거
// 이벤트 순서: DataObject.onsuccess → DataObject.onload → Dataset.onload
//   onload 에서 ColumnInfo(datapath) 재정의 → loadFromDataObject()
//   Dataset.onload 에서 rowcount 기반 상태 표시

this.DataObjectSample_onload = function(obj, e)
{
    this.bCreated = false;
    this.stc_status.set_text("① [DataObject 동적 생성] 버튼 클릭 → ② [게시글 조회] 클릭 순서로 실행하세요.");
};

this.btn_create_onclick = function(obj, e)
{
    if (this.bCreated) { this.stc_status.set_text("이미 생성되어 있습니다. 삭제 후 다시 시도하세요."); return; }

    // ────── DataObject 동적 생성 ──────────────────────────
    var dobj = new nexacro.DataObject("doUserList", this);
    this.addChild("doUserList", dobj);
    dobj.addEventHandler("onsuccess",       this.dobj_api_onsuccess, this);
    dobj.addEventHandler("onload",          this.dobj_api_onload,    this);
    dobj.addEventHandler("onerror",         this.dobj_api_onerror,   this);

    // ────── Dataset 동적 생성 + DataObject 자동 바인딩 ────
    var ds = new nexacro.Dataset("ds_result", this);
    this.addChild("ds_result", ds);
    ds.binddataobject     = "doUserList";  // DataObject 바인딩 (자동 연결)
    ds.dataobjectpath     = "$[*]";       // 루트가 배열인 REST 응답 경로
    ds.dataobjectbindmode = "twoway";     // 양방향 바인딩
	ds.updatecontrol = true;
    ds.addEventHandler("onload", this.ds_result_onload, this);

    // ────── Grid 동적 생성 ────────────────────────────────
    var grd = new nexacro.Grid("grd_result", 5, 5, 1230, 480, null, null);
    this.div_grid.addChild("grd_result", grd);
    grd.show();

    this.bCreated = true;
    this.stc_status.set_text("✔ new nexacro.DataObject() + new nexacro.Dataset() + new nexacro.Grid() 동적 생성 완료!");
    this.stc_result.set_text("이제 [게시글 조회] 또는 [사용자 조회] 버튼을 클릭하세요.");
};

this.btn_search_onclick = function(obj, e)
{
    var dobj = this["doUserList"];
    if (!dobj) { this.stc_status.set_text("먼저 DataObject를 동적 생성하세요."); return; }
    this.stc_status.set_text("조회 중... (GET /posts)");
    dobj.request("SEARCH_POSTS", "GET", "https://jsonplaceholder.typicode.com/posts");
};

this.btn_users_onclick = function(obj, e)
{
    var dobj = this["doUserList"];
    if (!dobj) { this.stc_status.set_text("먼저 DataObject를 동적 생성하세요."); return; }
    this.stc_status.set_text("조회 중... (GET /users)");
    dobj.request("SEARCH_USERS", "GET", "https://jsonplaceholder.typicode.com/users");
};

this.dobj_api_onsuccess = function(obj, e)
{
    trace("[onsuccess] serviceid=" + e.serviceid + " / statuscode=" + e.statuscode);
    if (e.statuscode > 200)
    {
        e.preventDefault();
        this.stc_status.set_text("통신 오류: HTTP " + e.statuscode);
    }
};

this.dobj_api_onload = function(obj, e)
{
    // DataObject.data → Dataset 자동 반영 흐름
    //   loadFromDataObject()가 DataObject.data를 dataobjectpath($[*])로 필터링 후
    //   각 ColumnInfo의 datapath(@.키명)에 따라 값을 자동 매핑 → addRow/setColumn 루프 불필요
    var ds  = this["ds_result"];
    var grd = this.div_grid.form.all["grd_result"];
    if (!ds || !grd) return;

    if (!(obj.data instanceof Array) || obj.data.length == 0)
    {
        this.stc_status.set_text("조회된 데이터가 없습니다.");
        return;
    }

    // 컬럼 전체 초기화 (엔드포인트 전환 시 이전 컬럼 제거)
    ds.clear();

    // 첫 번째 객체의 키를 기반으로 ColumnInfo 동적 생성
    // new ColumnInfo() = nexacro.DSColumnInfo (Platform.js에서 _jsContext.ColumnInfo로 전역 등록)
    // type setter가 ntype(정수 타입코드)을 자동 계산 — JS 리터럴 전달 시 ntype=undefined → 타입 변환 함수 미설정
	
    var firstItem = obj.data[0];
	let nCount = 0;
    for (var key in firstItem)
    {
		var colInfo = new ColumnInfo();
        colInfo.type     = "String";
        colInfo.datapath = "@." + key;
        colInfo.size     = 256;
        ds.addColumnInfo(key.toUpperCase(), colInfo);
	//   ds.addColumn(key.toUpperCase(), "String", 256,"@." + key);
		nCount++;
   }
   for ( var i = 0 ; i < nCount ; i++)
   {
	trace(ds.getColumnInfo(i))
	trace(ds.getColumnInfo(i).datapath);
   }
    // DataObject.data 를 Dataset 에 자동 반영 — addRow/setColumn 루프 완전 대체
    ds.loadFromDataObject();

    // Grid 바인딩 후 포맷 재생성
    grd.set_binddataset("ds_result");
    grd.createFormat();
    grd.set_autofittype("col");

    this.stc_result.set_text("serviceid=" + e.serviceid + " | 컬럼 수: " + ds.getColCount() + " | 첫 번째 값: " + ds.getColumn(0, 0));
};

// Dataset.onload — loadFromDataObject() 완료 후 rowcount 확정 시점
this.ds_result_onload = function(obj, e)
{
    trace("[ds_result_onload] rowcount=" + obj.rowcount + " reason=" + e.reason);
    var oForm = this;
    oForm.stc_status.set_text("✔ 조회 완료: " + obj.rowcount + "건 / 컬럼 수: " + obj.getColCount());
};

this.dobj_api_onerror = function(obj, e)
{
    trace("[onerror] " + e.statuscode + ":" + e.errormsg);
    this.stc_status.set_text("통신 오류: " + e.statuscode + " / " + e.errormsg);
};

this.btn_clear_onclick = function(obj, e)
{
    // Div 내 동적 생성 컴포넌트는 div.form.all[id] 로 접근
    var grd  = this.div_grid.form.all["grd_result"];
    var ds   = this["ds_result"];
    var dobj = this["doUserList"];
    if (grd)  { this.div_grid.removeChild("grd_result"); grd.destroy(); }
    if (ds)   { this.removeChild("ds_result"); ds.destroy(); }
    if (dobj) { this.removeChild("doUserList"); dobj.destroy(); }
    this.bCreated = false;
    this.stc_status.set_text("DataObject / Dataset / Grid 삭제 완료");
    this.stc_result.set_text("");
};
    ]]></Script>
  </Form>
</FDL>
