<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="Form_Work" width="1280" height="720" titletext="Form_Work">
    <Layouts>
      <Layout width="1280" height="720" screenid="Desktop_screen">
        <NexacroPortal id="NexacroPortal_00" taborder="0" text="Button00" left="41" top="30" width="619" height="523" appkey="nexacroK_mfe_sub2" apppath="http://172.10.12.45:9090/nexacroK/nexacroK_mfe_sub2" automount="false" onmount="NexacroPortal_00_onmount" onunmount="NexacroPortal_00_onunmount" onerror="NexacroPortal_00_onerror"/>
        <TextArea id="TextArea00" taborder="0" left="706" top="43" width="404" height="357"/>
        <Button id="Button00" taborder="1" text="mount" left="706" top="410" width="160" height="63" onclick="Button00_onclick"/>
        <Button id="Button01" taborder="2" text="unmount" left="878" top="412" width="172" height="63" onclick="Button01_onclick"/>
      </Layout>
    </Layouts>
    <Script type="xscript5.1"><![CDATA[
this.Button01_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	this.NexacroPortal_00.unmount();
};

this.Button00_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	trace("Button00_onclick");
	this.NexacroPortal_00.mount();
};

this.NexacroPortal_00_onmount = function(obj, e)
{
	this.TextArea00.deleteText();
	this.TextArea00.insertText("NexacroPortal_00_onmount obj = "+ obj
								+" NexacroPortal_00_onmount e = "+e);
	trace("NexacroPortal_00_onmount obj = "+ obj
								+" NexacroPortal_00_onmount e = "+e);
}

this.NexacroPortal_00_onunmount = function(obj, e)
{
	this.TextArea00.deleteText();
	this.TextArea00.insertText("NexacroPortal_00_onunmount obj = "+ obj
								+" NexacroPortal_00_onmount e = "+e);
	trace("NexacroPortal_00_onunmount obj = "+ obj
								+" NexacroPortal_00_onmount e = "+e);
}

this.NexacroPortal_00_onerror = function(obj, e)
{
	this.TextArea00.deleteText();
	this.TextArea00.insertText("NexacroPortal_00_onerror obj = "+ obj
								+" NexacroPortal_00_onerror e = "+e);
	trace("NexacroPortal_00_onerror obj = "+ obj
								+" NexacroPortal_00_onerror e = "+e)
}
]]></Script>
  </Form>
</FDL>
