<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="hotkey_sub5" width="1280" height="720" titletext="New Form">
    <Layouts>
      <Layout height="720" width="1280">
        <Static id="Static00" taborder="0" text="CTRL+ALT+I" left="51" top="53" width="399" height="57"/>
        <Button id="Button00" taborder="1" text="Button00" left="48" top="125" width="145" height="50" hotkey="CTRL+ALT+I" onclick="Button00_onclick"/>
        <Edit id="Edit00" taborder="2" left="231" top="120" width="264" height="59"/>
        <CheckBox id="CheckBox00" taborder="3" text="CTRL+ALT+J" left="48" top="221" width="260" height="39" hotkey="CTRL+ALT+J" onclick="CheckBox00_onclick"/>
        <Button id="Button01" taborder="4" text="$.fn.jquery" left="51" top="270" width="162" height="62" onclick="Button01_onclick"/>
      </Layout>
    </Layouts>
    <Script type="xscript5.1"><![CDATA[
this.CheckBox00_onclick = function(obj:nexacro.CheckBox,e:nexacro.ClickEventInfo)
{
	this.Edit00.value = "";
	this.Edit00.value = "CheckBox hotkey = "+obj.hotkey;
};

this.Button00_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	this.Edit00.value = "";
	this.Edit00.value = "Edit00 hotkey = "+obj.hotkey;
};
	
this.Button01_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	this.Edit00.value = "";
	this.Edit00.value ="$.fn.jquery ="+$.fn.jquery;
};
]]></Script>
