      <Method name="isPrimaryMonitor" group="" async="false" usecontextmenu="false" deprecated="false" unused="false" requirement="Windows NRE,macOS NRE" description="다중 모니터 일 때, 지정한 모니터가 주 모니터인지 반환하는 메소드입니다.">
        <Syntax text="system.isPrimaryMonitor(nMonitorIndex)">
          <Return type="Boolean" description="지정한 모니터가 주 모니터이면 &quot;true&quot; 를 반환합니다.&#xA;지정한 모니터가 주 모니터가 아니면 &quot;false&quot; 를 반환합니다." />
          <Arguments>
            <Argument name="nMonitorIndex" type="Number" in="false" out="false" option="false" variable="false" description="주 모니터 여부를 판단할 모니터의 번호를 설정합니다." />
          </Arguments>
        </Syntax>
